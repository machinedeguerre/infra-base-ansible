# Managed by ansible (infra.base.kubernetes): smtp-relay component.
# In-cluster SMTP relay — authenticated plaintext submission on the Service
# ports 587 and 25 (ClusterIP only), relaying to the upstream defined by the
# vault secret <ns>/smtp-upstream (url). One SASL account per client
# namespace (mail@<client>), each delivered as Secret "smtp" in its own
# namespace. See the kubernetes role defaults for the full contract.
{% set _ns = kubernetes_smtp_relay_namespace %}
{% set _url = kubernetes_secrets[_ns ~ '/smtp-upstream'].url %}
{% set _scheme = _url | urlsplit('scheme') %}
{% set _host = _url | urlsplit('hostname') %}
{% set _port = (_url | urlsplit('port')) or (465 if _scheme == 'smtps' else 587) %}
{% set _env = {
     'RELAYHOST': '[' ~ _host ~ ']:' ~ _port,
     'RELAYHOST_USERNAME': (_url | urlsplit('username') or '') | urldecode,
     'RELAYHOST_PASSWORD': (_url | urlsplit('password') or '') | urldecode,
     'POSTFIX_smtp_tls_security_level': 'encrypt',
   } %}
{% if _scheme == 'smtps' %}
{%   set _ = _env.update({'POSTFIX_smtp_tls_wrappermode': 'yes'}) %}
{% endif %}
{% set _sasl = [] %}
{% for _client in kubernetes_smtp_relay_clients | sort %}
{%   set _ = _sasl.append('mail@' ~ _client ~ ':'
       ~ kubernetes_secrets[_ns ~ '/smtp-auth-' ~ _client].password) %}
{% endfor %}
{% set _ = _env.update({'SMTPD_SASL_USERS': _sasl | join(',')}) %}
{% if kubernetes_smtp_relay_sender_domains | length > 0 %}
{%   set _ = _env.update({'ALLOWED_SENDER_DOMAINS':
       kubernetes_smtp_relay_sender_domains | join(' ')}) %}
{% else %}
{%   set _ = _env.update({'ALLOW_EMPTY_SENDER_DOMAINS': 'true'}) %}
{% endif %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ _ns }}
---
apiVersion: v1
kind: Secret
metadata:
  name: smtp-relay-env
  namespace: {{ _ns }}
type: Opaque
data:
{% for _key, _value in _env | dictsort %}
  {{ _key }}: {{ _value | string | b64encode }}
{% endfor %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: smtp-relay
  namespace: {{ _ns }}
  labels:
    app: smtp-relay
spec:
  replicas: 1
  selector:
    matchLabels:
      app: smtp-relay
  template:
    metadata:
      labels:
        app: smtp-relay
      annotations:
        # Rotating the upstream url or a client password re-renders this
        # hash, which rolls the pod so postfix picks up the new values.
        checksum/smtp-relay-env: {{ _env | dictsort | to_json | hash('sha256') }}
    spec:
      containers:
        - name: postfix
          image: {{ kubernetes_smtp_relay_image }}
          envFrom:
            - secretRef:
                name: smtp-relay-env
          ports:
            - name: smtp
              containerPort: 587
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - kill -0 "$(cat /var/spool/postfix/pid/master.pid)"
            initialDelaySeconds: 5
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - kill -0 "$(cat /var/spool/postfix/pid/master.pid)"
            initialDelaySeconds: 30
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 256Mi
          # No restrictive securityContext: postfix master runs as root in
          # the container and drops privileges per service itself; blocking
          # privilege escalation would break its setgid postdrop/maildrop.
---
apiVersion: v1
kind: Service
metadata:
  name: smtp
  namespace: {{ _ns }}
spec:
  selector:
    app: smtp-relay
  ports:
    # Same authenticated plaintext listener on both — only the client's
    # port convention differs. 465 (implicit TLS) deliberately absent.
    - name: submission
      port: 587
      targetPort: smtp
    - name: smtp
      port: 25
      targetPort: smtp
{% for _client in kubernetes_smtp_relay_clients | sort %}
---
# Client credentials for namespace "{{ _client }}" — everything an app needs
# to send mail through the relay. The namespace itself is owned by the app's
# manifest; k3s retries this Secret until it exists.
apiVersion: v1
kind: Secret
metadata:
  name: smtp
  namespace: {{ _client }}
type: Opaque
data:
  server: {{ ('smtp.' ~ _ns ~ '.svc') | b64encode }}
  port: {{ '587' | b64encode }}
  username: {{ ('mail@' ~ _client) | b64encode }}
  password: {{ kubernetes_secrets[_ns ~ '/smtp-auth-' ~ _client].password | b64encode }}
{% endfor %}
