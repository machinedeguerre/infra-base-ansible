# Managed by ansible (infra.base.kubernetes): vault-backed kubernetes
# Secrets rendered from the kubernetes_secrets variable, plus the DERIVED
# known_hosts keys (kubernetes_known_hosts_secrets). Do not edit here —
# edit the vault with `./infratool kubernetes_secret ...`, and the derived
# keys in kubernetes_secrets_declared.yml.
{# known_hosts for a list of declared hosts: one line per host key per
    host, with the declared addresses as the host pattern (or the host's
    ansible_host plus its inventory name). The material is the PUBLIC half
    of the host keys this repo already manages for that machine
    (sshd_host_keys), so a host key rotation needs no action here.
    Soundness — hosts exist, keys exist, no data key with two sources — is
    asserted in manifests.yml before this template runs. #}
{% macro known_hosts(entries) -%}
{%- set lines = [] -%}
{%- for entry in entries -%}
{%-   set host = entry.host if entry is mapping else entry -%}
{%-   set addresses = entry.addresses
                      if (entry is mapping and entry.addresses is defined)
                      else [hostvars[host].ansible_host | default(host), host] -%}
{%-   for hostkey in hostvars[host].sshd_host_keys | default([]) -%}
{%-     set _ = lines.append((addresses | unique | join(',')) ~ ' '
                             ~ hostkey.public | trim) -%}
{%-   endfor -%}
{%- endfor -%}
{{ lines | join('\n') }}
{% endmacro %}
{# kubernetes_secret_references (checked-in yml) renders a full copy of
    the referenced vault secret in the referencing namespace (soundness is
    also asserted in manifests.yml). A referenced secret's derived keys
    follow the copy, so a reference always carries what its target does. #}
{% for ref in (kubernetes_secrets.keys() | list
               + kubernetes_known_hosts_secrets.keys() | list
               + kubernetes_secret_references.keys() | list) | unique | sort %}
{% set target = kubernetes_secret_references.get(ref) | default(ref, true) %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ ref.split('/', 1)[1] }}
  namespace: {{ ref.split('/', 1)[0] }}
type: Opaque
data:
{% for key, value in (kubernetes_secrets.get(target) or {}) | dictsort %}
  {{ key }}: {{ value | b64encode }}
{% endfor %}
{% for key, entries in (kubernetes_known_hosts_secrets.get(target) or {}) | dictsort %}
  {{ key }}: {{ known_hosts(entries) | b64encode }}
{% endfor %}
{% endfor %}
