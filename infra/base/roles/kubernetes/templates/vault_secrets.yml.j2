# Managed by ansible (infra.base.kubernetes): vault-backed kubernetes
# Secrets rendered from the kubernetes_secrets variable. Do not edit here —
# edit the vault with `./infratool kubernetes_secret ...` instead.
{% for ref, data in kubernetes_secrets | dictsort %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ ref.split('/', 1)[1] }}
  namespace: {{ ref.split('/', 1)[0] }}
type: Opaque
data:
{% for key, value in data | dictsort %}
  {{ key }}: {{ value | b64encode }}
{% endfor %}
{% endfor %}
