# Managed by ansible (infra.base.kubernetes): vault-backed kubernetes
# Secrets rendered from the kubernetes_secrets variable. Do not edit here —
# edit the vault with `./infratool kubernetes_secret ...` instead.
{# kubernetes_secret_references (checked-in yml) renders a full copy of the
   referenced vault secret in the referencing namespace (soundness is
   asserted in manifests.yml before this template runs). #}
{% for ref, data in (kubernetes_secrets | dictsort)
                  + (kubernetes_secret_references | dictsort) %}
{% set data = kubernetes_secrets[data] if data is string else data %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ ref.split('/', 1)[1] }}
  namespace: {{ ref.split('/', 1)[0] }}
type: Opaque
data:
{% for key, value in data | dictsort %}
  {{ key }}: {{ value | b64encode }}
{% endfor %}
{% endfor %}
