pki:
  ca: {{ nebula_pki_dir }}/ca.crt
  cert: {{ nebula_pki_dir }}/host.crt
  key: {{ nebula_pki_dir }}/host.key
{% if nebula_blocklist | default([]) | length > 0 %}
  # Revoked certificate fingerprints (nebula has no CRL; this is the
  # revocation mechanism — distributed to every node by the playbook).
  blocklist:
{% for fp in nebula_blocklist %}
    - "{{ fp }}"
{% endfor %}
{% endif %}

tun:
  device: tun0
{% set _filtered_routes = nebula_unsafe_routes | default([]) | selectattr('via', 'ne', nebula_ip) | list %}
{% if _filtered_routes | length > 0 %}
  unsafe_routes:
{% for route in _filtered_routes %}
{% if route.route not in (nebula_unsafe_networks | default([])) %}
    - route: {{ route.route }}
      via: {{ route.via }}
{% endif %}
{% endfor %}
{% endif %}

{% set is_lighthouse = 'lighthouse' in _nebula_effective_groups %}
static_host_map:
{% for k, v in nebula_static_host_map.items() if not (is_lighthouse and k == nebula_ip) %}
  "{{ k }}":
{% for addr in v %}
    - "{{ addr }}"
{% endfor %}
{% endfor %}

lighthouse:
  am_lighthouse: {{ is_lighthouse | lower }}
  hosts:
{% for ip in nebula_lighthouse_ip if not (is_lighthouse and ip == nebula_ip) %}
    - "{{ ip }}"
{% endfor %}

listen:
  host: 0.0.0.0
  port: {{ nebula_listen_port }}

punchy:
  punch: true
  respond: true

relay:
  am_relay: {{ is_lighthouse | lower }}
  use_relays: {{ (not is_lighthouse) | lower }}
{% if not is_lighthouse %}
  relays:
{% for ip in nebula_lighthouse_ip %}
    - "{{ ip }}"
{% endfor %}
{% endif %}

firewall:
  inbound:
    # Allow ICMP to this host's own address from admin devices (sysop) and
    # managed nodes (infra). Stateful: replies to allowed pings always flow.
    # (No local_cidr: traffic THROUGH this host to routed subnets is
    # governed solely by the sysop rules below.)
    - port: any
      proto: icmp
      group: sysop
    - port: any
      proto: icmp
      group: infra

    # Allow SSH to this host's own address from admin devices (sysop) and
    # from managed nodes (infra) — the latter enables node-to-node SSH
    # hops when the overlay is partially split. Deliberately NOT host: any:
    # external bundles without these groups get no SSH surface.
    - port: 22
      proto: tcp
      group: sysop
    - port: 22
      proto: tcp
      group: infra

{% if 'proxmox' in _nebula_effective_groups %}
    # Allow Proxmox web interface (port 8006) from sysop group
    - port: 8006
      proto: tcp
      group: sysop
{% endif %}

{% if 'webhost' in _nebula_effective_groups %}
    # Allow HTTP/HTTPS inbound to webhost from any nebula peer
    # (intentionally no local_cidr -- traffic to VM subnets must go via haproxy,
    # not be exposed directly over the overlay)
    - port: 80
      proto: tcp
      host: any
    - port: 443
      proto: tcp
      host: any
{% endif %}

{% if nebula_unsafe_networks | default([]) | length > 0 %}
    # Allow traffic into routed (unsafe) subnets: always from sysop, plus any
    # per-subnet extra groups (nebula_unsafe_networks_extra_groups). These
    # local_cidr rules are the ONLY rules that apply to this traffic — since
    # nebula 1.9, rules without local_cidr match the host's own address only.
{% for subnet in nebula_unsafe_networks %}
{% for grp in (['sysop'] + (nebula_unsafe_networks_extra_groups | default({})).get(subnet, [])) | unique %}
    - port: any
      proto: any
      group: {{ grp }}
      local_cidr: "{{ subnet }}"
{% endfor %}
{% endfor %}
{% endif %}

  outbound:
    # Allow all outbound traffic to any host
    - port: any
      proto: any
      host: any
{% if nebula_unsafe_networks | default([]) | length > 0 %}
      local_cidr: any
{% endif %}
