# Debian preseed configuration for Packer template build

# Localization
d-i debian-installer/locale string {{ proxmox_template_preseed_locale }}
d-i keyboard-configuration/xkb-keymap select {{ proxmox_template_preseed_keyboard }}
d-i console-setup/ask_detect boolean false

# Network configuration
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string debian
d-i netcfg/get_domain string unassigned-domain

# Mirror settings
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string {{ proxmox_template_preseed_mirror_directory }}
d-i mirror/http/proxy string

# Clock and time zone setup
d-i clock-setup/utc boolean true
d-i time/zone string {{ proxmox_template_preseed_timezone }}
d-i clock-setup/ntp boolean true

# Partitioning
d-i partman-auto/method string lvm
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-auto-lvm/guided_size string max
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# Base system installation
d-i base-installer/kernel/image string linux-image-amd64

# Account setup - set a temporary root password for Packer SSH access
# (password will be locked after provisioning)
d-i passwd/root-login boolean true
d-i passwd/root-password password {{ proxmox_template_preseed_root_password }}
d-i passwd/root-password-again password {{ proxmox_template_preseed_root_password }}
d-i passwd/make-user boolean false

# Package selection
tasksel tasksel/first multiselect minimal
d-i pkgsel/include string openssh-server qemu-guest-agent cloud-init
d-i pkgsel/upgrade select none
d-i pkgsel/update-policy select none

# Boot loader installation
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true
d-i grub-installer/bootdev string /dev/sda
d-i finish-install/keep-consoles boolean true
d-i finish-install/reboot_in_progress note

# Late command: install SSH key for Packer and configure sshd
# Logs to /var/log/preseed-late.log inside the installed system for debugging
d-i preseed/late_command string \
    exec > /target/var/log/preseed-late.log 2>&1 && set -x; \
    echo '=== Step 1: Create .ssh directory ===' && \
    mkdir -p /target/root/.ssh && \
    chmod 700 /target/root/.ssh && \
    echo '=== Step 2: Install SSH authorized key ===' && \
    echo '{{ proxmox_template_ssh_public_key }}' > /target/root/.ssh/authorized_keys && \
    chmod 600 /target/root/.ssh/authorized_keys && \
    echo '=== Step 3: Configure sshd PermitRootLogin ===' && \
    mkdir -p /target/etc/ssh/sshd_config.d && \
    echo 'PermitRootLogin yes' > /target/etc/ssh/sshd_config.d/permit-root-login.conf && \
    echo '=== All steps completed ==='
